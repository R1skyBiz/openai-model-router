# Consuming application only. Load these into the environment with your launcher.
MODEL_ROUTER_URL=http://127.0.0.1:8000
MODEL_ROUTER_APP_TOKEN=replace-with-application-scoped-router-token
MODEL_ROUTER_MODE=shadow
MODEL_ROUTER_CONNECT_TIMEOUT_S=2
MODEL_ROUTER_REQUEST_TIMEOUT_S=30
MODEL_ROUTER_DEFAULT_BUDGET_USD=0.01
MODEL_ROUTER_SAFE_RETRIES=1
MODEL_ROUTER_ALLOW_PAID_CLASSIFIER=false
# No provider credential belongs in the consuming application.
# Telemetry: attach opaque task_id and trace_id in Request; configure the host
# logger for example.router. Do not enable body/header or raw-content logging.
